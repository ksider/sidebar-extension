{
  "manifest_version": 3,
  "name": "Extension Switcher",
  "version": "1.0.0",
  "description": "A compact local sidebar for enabling and disabling installed extensions.",
  "permissions": ["management", "storage", "sidePanel"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Extension Switcher"
  },
  "side_panel": {
    "default_path": "dist/src/sidebar/index.html"
  }
}
